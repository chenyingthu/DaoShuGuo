{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Skill Implementation",
  "description": "技能实现详细描述，包含代码结构、设计决策和演化历史",
  "required": ["schema_version", "object_type", "skill_name", "code"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "object_type": {
      "type": "string",
      "const": "skill_implementation"
    },
    "skill_name": {
      "type": "string",
      "description": "技能名称"
    },
    "skill_version": {
      "type": "string",
      "description": "技能版本号"
    },
    "skill_family": {
      "type": "string",
      "description": "技能所属家族"
    },
    "author": {
      "type": "string",
      "description": "作者标识"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "skill_family": {"type": "string"},
        "author": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "last_modified": {"type": "string", "format": "date-time"},
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "code": {
      "type": "object",
      "required": ["main_file", "structure"],
      "properties": {
        "main_file": {
          "type": "string",
          "description": "主代码文件路径"
        },
        "git_commit": {
          "type": "string",
          "description": "Git commit hash"
        },
        "lines_range": {
          "type": "string",
          "description": "代码行范围"
        },
        "structure": {
          "type": "array",
          "minItems": 1,
          "description": "代码结构，至少描述一个函数",
          "items": {
            "type": "object",
            "required": ["function", "purpose", "algorithm"],
            "properties": {
              "function": {
                "type": "string",
                "description": "函数名称"
              },
              "lines": {
                "type": "string",
                "description": "代码行号"
              },
              "purpose": {
                "type": "string",
                "minLength": 20,
                "description": "函数目的，至少20字符"
              },
              "algorithm": {
                "type": "string",
                "description": "使用的算法"
              },
              "complexity": {
                "type": "string",
                "description": "时间/空间复杂度"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"},
                    "type": {"type": "string"},
                    "description": {"type": "string"}
                  }
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"},
                    "type": {"type": "string"},
                    "description": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "design_decisions": {
      "type": "array",
      "description": "设计决策记录",
      "items": {
        "type": "object",
        "required": ["decision", "alternatives_considered", "trade_offs"],
        "properties": {
          "decision": {
            "type": "string",
            "description": "做出的决策"
          },
          "context": {
            "type": "string",
            "description": "决策背景"
          },
          "alternatives_considered": {
            "type": "array",
            "minItems": 1,
            "description": "考虑过的替代方案",
            "items": {"type": "string"}
          },
          "trade_offs": {
            "type": "array",
            "minItems": 1,
            "description": "权衡分析",
            "items": {"type": "string"}
          },
          "validated": {
            "type": "boolean",
            "description": "是否验证过"
          },
          "validation_evidence": {
            "type": "string",
            "description": "验证证据"
          },
          "limitation_acknowledged": {
            "type": "string",
            "description": "承认的局限性"
          },
          "future_work": {
            "type": "string",
            "description": "未来改进方向"
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "参数配置",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "description": "参数值"
          },
          "rationale": {
            "type": "string",
            "description": "选择理由"
          },
          "tuned": {
            "type": "boolean",
            "description": "是否调优过"
          },
          "source": {
            "type": "string",
            "description": "参数来源"
          },
          "tuning_history": {
            "type": "array",
            "description": "调优历史",
            "items": {
              "type": "object",
              "required": ["attempt", "value", "result"],
              "properties": {
                "attempt": {
                  "type": "integer",
                  "description": "尝试次数"
                },
                "value": {
                  "description": "尝试的值"
                },
                "result": {
                  "type": "string",
                  "description": "结果"
                }
              }
            }
          }
        }
      }
    },
    "evolution": {
      "type": "object",
      "description": "技能演化历史",
      "properties": {
        "previous_version": {
          "type": "string",
          "description": "上一版本"
        },
        "changes_from_previous": {
          "type": "array",
          "description": "从上一版本的变化",
          "items": {"type": "string"}
        },
        "lessons_learned": {
          "type": "array",
          "description": "学到的教训",
          "items": {"type": "string"}
        },
        "deprecated_features": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "quality_metrics": {
      "type": "object",
      "description": "代码质量指标",
      "properties": {
        "test_coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "lint_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "cyclomatic_complexity": {
          "type": "object",
          "properties": {
            "overall": {"type": "integer"},
            "max_per_function": {"type": "integer"}
          }
        },
        "documentation": {
          "type": "object",
          "properties": {
            "docstring_coverage": {"type": "string"},
            "type_hints": {"type": "string"},
            "readme_completeness": {"type": "string"}
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "package": {"type": "string"},
              "version": {"type": "string"},
              "purpose": {"type": "string"}
            }
          }
        },
        "internal": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": {"type": "string"},
              "purpose": {"type": "string"}
            }
          }
        }
      }
    },
    "reusability": {
      "type": "object",
      "description": "可复用性评估",
      "properties": {
        "applicable_networks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "constraints": {
          "type": "array",
          "items": {"type": "string"}
        },
        "adaptation_required": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "changes": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
